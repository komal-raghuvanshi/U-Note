# ==============================================================================
# U-NOTE Backend Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file with secrets to version control.
# ==============================================================================

# Database Configuration (MySQL / Aiven Cloud)
UNOTE_DB_HOST=your-database-host.aivencloud.com
UNOTE_DB_PORT=3306
UNOTE_DB_USER=avnadmin
UNOTE_DB_PASSWORD=your-database-password
UNOTE_DB_NAME=defaultdb

# Security & Sessions
UNOTE_SECRET_KEY=your-secure-random-secret-key-at-least-32-chars
UNOTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Service Configuration (Email OTP & Contact Form)
# Priority chain: Resend API -> Brevo API -> Gmail/Custom SMTP -> Dev log fallback
EMAIL_SENDER_NAME=U-NOTE

# Option A: Gmail SMTP (Default supported provider)
UNOTE_EMAIL=your-app-email@gmail.com
UNOTE_EMAIL_APP_PASSWORD=your-google-app-password

# Option B: Resend (Alternative API provider)
# RESEND_API_KEY=re_123456789
# RESEND_FROM=U-NOTE <onboarding@resend.dev>

# Option C: Brevo / Sendinblue (Alternative API provider)
# BREVO_API_KEY=xkeysib-123456789
# BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com

# Option D: Custom SMTP Server
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=smtp-user
# SMTP_PASSWORD=smtp-password
